# Make does not read this file. Export DB user/name and storage settings before Make commands.
# See docs/public-guide.md#shared-make-and-compose-settings.
# SDDP Docker Compose Environment Variables
# Copy this file to .env for loopback-only evaluation.
# Do not reuse these credentials or the evaluation Compose profile for production.

# PostgreSQL Database Credentials
POSTGRES_USER=sddp
POSTGRES_PASSWORD=sddp_password
POSTGRES_DB=sddp

# Git checkout location (optional; repositories are configured in Project Settings)
# SDDP_GIT__REPOROOT=
# API-reachable Gitea origin; bundled service uses container port 3000, not host port 3100.
# SDDP_GIT__SERVERURL=http://sddp-gitea:3000

# Whisper STT container resource limits (optional)
# WHISPER_MEMORY_LIMIT=3G
# WHISPER_CPU_LIMIT=2
